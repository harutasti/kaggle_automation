{
  "kaggle_competition_name": "spaceship-titanic",
  "max_iterations": 5,
  "wca_per_iteration": 3,
  "stop_condition": {
    "no_improvement_iterations": 2
  },
  "experiments_base_dir": "./experiments",
  "log_file": "./logs/auto_kaggle.log",
  "log_level": "INFO",
  "simulation_mode": false,
  "use_crawler": true,
  "crawler_cache_enabled": true,
  "crawler_cache_ttl_hours": 24,
  "crawler_summary_enabled": true,
  "crawler_force_refresh": false,
  "max_discussions": 100,
  "analyze_dataset": true,
  "prompts_dir": "prompts",
  "experiment_pyproject_path": "config/experiment_pyproject.toml",
  "kse_codex_timeout": 3600,
  "pa_codex_timeout": 3600,
  "waa_resume_timeout": 3600,
  "process_completion_grace_seconds": 120,
  "training_idle_threshold_minutes": 3,
  "resource_monitor_interval_seconds": 30,
  "codex_live_view": {
    "enabled": true,
    "backend": "tmux",
    "title_prefix": "AutoKaggle",
    "viewer_timestamps": true,
    "viewer_idle_exit_seconds": 3.0,
    "viewer_theme": "dark"
  }
}
