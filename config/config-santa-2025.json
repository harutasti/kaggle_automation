{
  "kaggle_competition_name": "santa-2025",
  "max_iterations": 30,
  "wca_per_iteration": 10,
  "submit_each_iteration": false,
  "max_submissions_per_iteration": 5,
  "include_historical_results": true,
  "historical_results_max_runs": 3,
  "historical_results_limit": 200,
  "historical_results_include_failures": true,
  "stop_condition": {
    "score_threshold": null,
    "no_improvement_iterations": 2
  },
  "experiments_base_dir": "./experiments",
  "log_file": "./logs/auto_kaggle.log",
  "log_level": "INFO",
  "simulation_mode": false,
  "use_crawler": true,
  "max_discussions": 20,
  "analyze_dataset": true,
  "prompts_dir": "prompts",
  "experiment_pyproject_path": "config/experiment_pyproject.toml",
  "kse_codex_timeout": 3600,
  "pa_codex_timeout": 3600,
  "waa_resume_timeout": 3600,
  "kaggle_score_wait_timeout_seconds": 300,
  "kaggle_score_poll_interval_seconds": 10,
  "process_completion_grace_seconds": 120,
  "waa_resume_max_attempts": 2,
  "training_idle_threshold_minutes": 3,
  "resource_monitor_interval_seconds": 30,
  "slack_notify_on_iteration_end": true,
  "slack_webhook_env": "SLACK_WEBHOOK_URL",
  "codex_live_view": {
    "enabled": true,
    "backend": "tmux",
    "title_prefix": "AutoKaggle",
    "viewer_timestamps": true,
    "viewer_idle_exit_seconds": 3.0,
    "viewer_theme": "dark"
  }
}
